# MongoDB
MONGO_URI=mongodb://localhost:27017
DB_NAME=expense_auditor

# OCR provider: tesseract | google_vision (extensible)
OCR_PROVIDER=tesseract

# LLM (optional — set LLM_ENABLED=false to skip LLM checks)
LLM_ENABLED=false
OPENAI_API_KEY=sk-...

# Upload limits
MAX_UPLOAD_MB=20

# Policy defaults
POLICY_AMOUNT_THRESHOLD=1000.0
POLICY_ALLOWED_CURRENCIES=USD,EUR,GBP,INR
POLICY_ALLOW_WEEKEND_EXPENSES=false

# Auth — REQUIRED in production, must differ from the default below
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-replace-in-production-32x
JWT_EXPIRE_HOURS=24

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# App
APP_ENV=development
LOG_LEVEL=INFO

# ── S3 / File Storage (optional) ──────────────────────────────────────────────
# Leave S3_BUCKET_NAME empty to store files in MongoDB (default for local dev).
# Set it to use S3 (or Cloudflare R2 with S3_ENDPOINT_URL) for production scale.
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# For Cloudflare R2: S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=

# ── Sentry Error Tracking (optional) ──────────────────────────────────────────
# Create a free project at https://sentry.io — paste your DSN here.
SENTRY_DSN=

# ── Email Notifications via Resend (optional) ──────────────────────────────────
# Sign up at https://resend.com — add a verified domain and paste your API key.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=re_...
EMAIL_FROM=AuditFlow <noreply@yourdomain.com>
